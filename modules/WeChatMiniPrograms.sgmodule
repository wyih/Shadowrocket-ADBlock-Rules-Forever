#!url=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/modules/WeChatMiniPrograms.sgmodule
#!name=微信小程序去广告
#!desc=常用小程序去广告；修复原规则转换与响应兼容问题，内置原脚本的JSON过滤。作者署名在插件内。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/WeixinMiniPrograms.png
#!openUrl=https://apps.apple.com/app/id414478124
#!category=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-15

[Rule]
DOMAIN,wxsnsdy.wxs.qq.com,REJECT
DOMAIN,wxsmsdy.video.qq.com,REJECT
DOMAIN,wxsnsdythumb.wxs.qq.com,REJECT
DOMAIN,ads-shopping.shouqianba.com,REJECT
DOMAIN,ad.maoyan.com,REJECT
DOMAIN,e.jparking.cn,REJECT

[Body Rewrite]
http-response-jq (?i)^https:\/\/mcsp\.cloudpnr\.com\/api\/miniapp\/popular\/T_MINIAPP(?:\?|$) 'delpaths([["data"]])'
http-response-jq (?i)^https:\/\/saas-ad\.cloudpnr\.com\/huifuad-base-api\/api\/tactics\/ad(?:\?|$) 'delpaths([["data",0],["data",1],["data",2]])'
http-response-jq (?i)^https:\/\/rms\.meituan\.com\/api\/v1\/rmsmina\/c\/queryShopPortalInfo\? 'delpaths([["data","popUpWindows"]])'
http-response-jq (?i)^https:\/\/chong\.qq\.com\/tws\/wxmobile\/GetProduct4App\? 'del(.respInfo.reserveProductList) | .respInfo.shortcut |= map(select(.name != "充流量" and .name != "领话费券"))'
http-response-jq (?i)^https:\/\/chong\.qq\.com\/tws\/wxmobile4app\/GetSecondProduct\? 'del(.respInfo.productList) | .respInfo.shortcut |= map(select(.name != "充流量" and .name != "领话费券"))'
http-response-jq (?i)^https:\/\/chong\.qq\.com\/tws\/usernumberinfo\/GetUserInfo\? 'delpaths([["data","request","number","markSeat","servicehallOperList"],["data","request","number","servicehallOperList"],["data","request","number","markSeat","servicehallFuncList"],["data","request","number","servicehallFuncList"]])'

# 内置过滤来源与固定版本见 README.md 的“微信模块修复”。
# 企迈点单系统去广告
http-response-jq (?i)^https:\/\/webapi\.qmai\.cn\/web\/catering\/design\/homePage-Config '. as $original | try (.data.config |= (fromjson | map(select((.id // "") | test("13502ede-f5fd-4d5c-90f5-f2454a30fda0|c1caaf62-e91d-4040-b533-dab39c0fec13|cc9d17ec-3ac5-494b-b82e-8d3c72c243d4|7bef8fe9-0daf-46b3-a2b0-dd9fba49423f|ff7e1263-d8d2-4f09-9947-d8c43c77bb10|874197b4-fe93-4a80-a555-8df1bc7e8211|0ba6a615-b7e9-48aa-afe7-329635385f2c|a11b0e7d-a162-4802-ac71-21d98e8adddf") | not)) | tojson)) catch $original'
# EMS中国邮政物流速递去广告
http-response-jq (?i)^https:\/\/ump\.ems\.com\.cn\/new-generation-extend\/redis\/pageInfoByChannel '. as $original | try (.info.moduleJson |= (fromjson | map(select((.moduleName // "") | contains("广告") | not)) | tojson)) catch $original'
# 小兔充充去广告
http-response-jq (?i)^https:\/\/mapi\.xiaotucc\.com\/mall\/main(?:\?|$) 'del(.data)'
http-response-jq (?i)^https:\/\/mapi\.xiaotucc\.com\/main_page\/index\/getActivity(?:\?|$) 'del(.data.p3)'
# 全家微会员去广告
http-response-jq (?i)^https:\/\/minifm\.maxxipoint\.com\/banner\/list 'del(.data.topBanner)'
# 罗森点点去广告
http-response-jq (?i)^https:\/\/lawsonapi\.yorentown\.com\/area\/sh-lawson\/app\/v1\/home 'del(.data.homeButtonList, .data.dysmorphismPictureList)'
# 茶颜悦色去广告
http-response-jq (?i)^https:\/\/miniapp\.sexytea2013\.com\/cms\/slot\/queryByCodes\?codes=INDEX_TOP_BANNER 'del(.data.INDEX_SLOT_01, .data.INDEX_SLOT_02, .data.INDEX_TOP_BANNER)'
# COCO点单去广告
http-response-jq (?i)^https:\/\/coco-com\.e\.verystar\.net\/v1\/home\/info 'del(.data.top_background_url, .data.bottom_banner_list)'
# 滴滴青桔去广告
http-response-jq (?i)^https:\/\/htwkop\.xiaojukeji\.com\/gateway\?api=hm\.fa\.homeConfig 'del(.data.bannerInfoConfig)'
# 一点点+去广告
http-response-jq (?i)^https:\/\/cappapi\.alittle-tea\.com\/open\?method=catering\.set\.ad 'del(.data)'
# M Stand去广告
http-response-jq (?i)^https:\/\/api\.prod\.dj\.mstand\.cn\/scrm\/mini\/app\/index\/info 'del(.data.homeNewsAdv, .data.homeDineInAdv, .data.homePickupAdv, .data.nearbyShopInfo, .data.homeEventThemesAdv, .data.eventThemes, .data.homeRootAdv, .data.homeTopAdv, .data.homeDialogAdv, .data.homeBannerAdv, .data.homeCouponAdv, .data.homeCompanyAdv, .data.homeDeliveryAdv)'
# T3出行去广告
http-response-jq (?i)^https:\/\/passenger\.t3go\.cn\/(solution\-|common\-)?(passenger\-)?(activity\-|app\-)?api\/notoken\/(trip\/)?api\/(home\/|common\/)?(v[1-3]\/)?(ad\/getNegativescreen|solution\/passenger\/open\/getHomeMenu|leftmenu|getHomeInfoGlobal) 'del(.data)'
# 古茗去广告
http-response-jq (?i)^https:\/\/newton\.gumingnc\.com\/newton-buyer\/newton\/buyer\/(ump|touch|external\/front) '.data = []'


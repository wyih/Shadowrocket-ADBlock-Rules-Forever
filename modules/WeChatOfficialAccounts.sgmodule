#!url=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/modules/WeChatOfficialAccounts.sgmodule
#!name=微信公众号去广告
#!desc=过滤微信公众号广告
#!author=RuCu6[https://github.com/RuCu6]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weixin.png
#!openUrl=https://apps.apple.com/app/id414478124
#!category=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-15

[Rule]
DOMAIN-SUFFIX,wxs.qq.com,REJECT

[Body Rewrite]
# 按 NobyDa 原脚本清空广告列表，保留返回的其余字段。
http-response-jq (?i)^https:\/\/mp\.weixin\.qq\.com\/mp\/getappmsgad(?:\?|$) '.advertisement_num = 0 | .advertisement_info = [] | del(.appid)'

[Script]
公众号本地响应1 = type=http-request, pattern=(?i)^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|jsmonitor|masonryfeed|relatedarticle)(?:\?|$), script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/wechat-ad-response.js, timeout=5, engine=webview, argument=dict

公众号本地响应2 = type=http-request, pattern=(?i)^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword, script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/wechat-ad-response.js, timeout=5, engine=webview, argument=dict

[MITM]
hostname = %APPEND% mp.weixin.qq.com

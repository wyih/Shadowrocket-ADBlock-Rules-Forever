#!url=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/modules/TencentVideo.sgmodule
#!name=腾讯视频去广告
#!desc=过滤已识别的首页推荐流广告卡片、广告素材与播放广告参数。首页过滤需启用 MITM 并信任证书；未知响应结构原样保留，9.04.60 客户端效果待实测。
#!author=RuCu6[https://github.com/RuCu6]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Tencent_Video.png
#!openUrl=https://apps.apple.com/app/id458318329
#!category=去广告
#!loon_version=3.5.1(998)
#!homepage=https://hub.kelee.one
#!date=2026-10-15
#!version=20261015.2

[Rule]
DOMAIN,adsmind.gdtimg.com,REJECT
DOMAIN,info4.video.qq.com,REJECT
DOMAIN,info6.video.qq.com,REJECT
DOMAIN,ios.video.mpush.qq.com,REJECT
DOMAIN,otheve.beacon.qq.com,REJECT
DOMAIN,pgdt.gtimg.cn,REJECT
DOMAIN,tpns.qq.com,REJECT
DOMAIN,vv6.video.qq.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,l.qq.com,REJECT
DOMAIN-KEYWORD,trace.qq.com,REJECT
DOMAIN-KEYWORD,trace.video.qq.com,REJECT
IP-CIDR,47.110.187.87/32,REJECT,no-resolve
URL-REGEX,"^http:\/\/[\d\.:]*\/?(defaultts\.tc|vmind\.qqvideo\.tc|finderpdd\.video)\.qq\.com\/\w+",REJECT
URL-REGEX,"^http:\/\/apd-vlive\.apdcdn\.tc\.qq\.com\/vmind\.qqvideo\.tc\.qq\.com\/\w+",REJECT
URL-REGEX,"^http:\/\/apd-\w+\.v\.smtcdns\.com\/(defaultts|omts|vmind\.qqvideo)\.tc\.qq\.com\/\w+",REJECT

[Map Local]
(?i)^https?:\/\/vv\.video\.qq\.com\/(diff|get)vmind data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
移除广告 = type=http-request, pattern=(?i)^https?:\/\/(?:s)?vv\.video\.qq\.com\/getvinfo(?:\?|$), script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/tencent-video-request.js, requires-body=true
首页广告卡片 = type=http-response, pattern=(?i)^https:\/\/i\.video\.qq\.com\/$, script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/tencent-video-feed.js, requires-body=true, binary-body-mode=true, max-size=2097152, timeout=10

[MITM]
# 日志中出现的直连入口；脚本仍只处理 i.video.qq.com 的已识别首页响应。
hostname = %APPEND% vv.video.qq.com, svv.video.qq.com, i.video.qq.com, 36.155.163.124:443, 120.241.130.172:443, 36.155.163.112:443, 36.155.205.219:443, 120.232.131.191:443, 120.241.130.240:443

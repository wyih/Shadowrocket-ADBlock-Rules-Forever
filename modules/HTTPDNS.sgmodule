#!url=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/modules/HTTPDNS.sgmodule
#!name=通用广告拦截器
#!desc=合并 HTTPDNS 拦截、广告平台拦截器及可莉广告过滤器。保留嘀嗒和短信验证例外；各 App 专用模块继续启用。本模块置顶，更新后停用原广告平台拦截器和可莉广告过滤器。
#!author=wyih
#!homepage=https://github.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tree/tailscale/modules
#!category=去广告, 依赖
#!date=2026-10-18
#!version=20261018.1

# HTTPDNS baseline: 可莉、VirgilClyne; advertising rules: 可莉 (2026-10-02 user-installed versions).
# Sources and migration notes: modules/README.md. Keep this subscription URL for updates.

[Rule]

# HTTPDNS — preserve allow rules before broader rejections.

DOMAIN-KEYWORD,httpdns,REJECT
DOMAIN-KEYWORD,httpsdns,REJECT
USER-AGENT,httpdns*,REJECT
USER-AGENT,httpsdns*,REJECT

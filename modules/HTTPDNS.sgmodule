[Script]
HTTPDNS IPv4解析 = type=http-request, pattern=^http:\/\/(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?::80)?(?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)(?:\?|$), script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/httpdns-response.js?v=20261017.1, engine=webview, timeout=5
HTTPDNS IPv6解析 = type=http-request, pattern=^http:\/\/\[[0-9a-fA-F:.]+\](?::80)?(?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)(?:\?|$), script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/httpdns-response.js?v=20261017.1, engine=webview, timeout=5
HTTPDNS AMDC调度 = type=http-request, pattern=^http:\/\/(?:amdc\.m\.taobao\.com|(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|\[[0-9a-fA-F:.]+\])(?::80)?\/amdc\/mobileDispatch(?:\?|$), script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/httpdns-response.js?v=20261017.1, engine=webview, timeout=5
HTTPDNS YY解析 = type=http-request, pattern=^http:\/\/103\.44\.58\.64(?::80)?\/md(?:\?|$), script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/httpdns-response.js?v=20261017.1, engine=webview, timeout=5
HTTPDNS 虎牙解析 = type=http-request, pattern=^http:\/\/cdn\.wup\.huya\.com(?::80)?\/launch\/queryHttpDns(?:\?|$), script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/httpdns-response.js?v=20261017.1, engine=webview, timeout=5
HTTPDNS 喜马拉雅解析 = type=http-request, pattern=^http:\/\/xmc\.ximalaya\.com(?::80)?\/xmlymain-login-web\/login\/, script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/httpdns-response.js?v=20261017.1, engine=webview, timeout=5
HTTPDNS 美团解析 = type=http-request, pattern=^http:\/\/103\.37\.155\.60(?::80)?\/fetch(?:\?|$), script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/httpdns-response.js?v=20261017.1, engine=webview, timeout=5
HTTPDNS 知乎解析 = type=http-request, pattern=^http:\/\/103\.41\.167\.237(?::80)?\/v2\/resolv(?:\?|$), script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/httpdns-response.js?v=20261017.1, engine=webview, timeout=5
HTTPDNS 微博配置 = type=http-request, pattern=^http:\/\/api\.weibo\.cn(?::80)?\/(?:2\/)?httpdns\/config(?:\?|$), script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/httpdns-response.js?v=20261017.1, engine=webview, timeout=5
HTTPDNS 字节配置 = type=http-request, pattern=^http:\/\/(?:[a-z0-9-]+\.)+zijieapi\.com(?::80)?\/get_domains\/, script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/httpdns-response.js?v=20261017.1, engine=webview, timeout=5
HTTPDNS 微信CDN解析 = type=http-request, pattern=^http:\/\/(?:short|hkextshort)\.weixin\.qq\.com(?::80)?\/cgi-bin\/micromsg-bin\/getcdndns(?:\?|$), script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/httpdns-response.js?v=20261017.1, engine=webview, timeout=5
HTTPDNS 支付宝IPv4解析 = type=http-request, pattern=^http:\/\/(?:110\.76\.8\.150|203\.209\.(?:230\.39|245\.(?:102|158)|247\.95|250\.(?:41|114)|251\.147))(?::80)?\/squery(?:\?|$), script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/httpdns-response.js?v=20261017.1, engine=webview, timeout=5
HTTPDNS 支付宝IPv6解析 = type=http-request, pattern=(?i)^http:\/\/\[2400:(?:b180:6001::18f|b200:(?:1005:3000::(?:155|1d3)|5000:b000::c8))\](?::80)?\/squery(?:\?|$), script-path=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/scripts/httpdns-response.js?v=20261017.1, engine=webview, timeout=5

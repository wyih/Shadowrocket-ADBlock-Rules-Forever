#!url=https://raw.githubusercontent.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tailscale/modules/HTTPDNS.sgmodule
#!name=HTTPDNS拦截器
#!desc=拦截 App 自带的 HTTPDNS 解析，供各去广告模块共用。保留嘀嗒出行例外；解析接口使用请求脚本返回空 404，使支持回退的客户端改用系统 DNS。
#!author=wyih
#!homepage=https://github.com/wyih/Shadowrocket-ADBlock-Rules-Forever/tree/tailscale/modules
#!category=去广告, 依赖
#!date=2026-10-17
#!version=20261017.3

# Based on the user's Kelee/VirgilClyne module; upstream references are in modules/README.md.
[Rule]
DOMAIN-KEYWORD,httpdns,REJECT
DOMAIN-KEYWORD,httpsdns,REJECT
USER-AGENT,httpdns*,REJECT
USER-AGENT,httpsdns*,REJECT
USER-AGENT,Httpdns*,REJECT
USER-AGENT,Httpsdns*,REJECT
AND,((URL-REGEX,^http:\/\/119\.29\.29\.90\/d\?),(USER-AGENT,%E5%98%80%E5%97%92%E5%87%BA%E8%A1%8C*)),DIRECT
AND,((URL-REGEX,^http:\/\/119\.28\.28\.90\/d\?),(USER-AGENT,%E5%98%80%E5%97%92%E5%87%BA%E8%A1%8C*)),DIRECT
# Preserve the on-device verified FleaMarket AMDC rejection in this shared layer.
AND,((URL-REGEX,^http:\/\/(?:amdc\.m\.taobao\.com|(?:[0-9]+\.){3}[0-9]+)(?::80)?\/amdc\/mobileDispatch(?:\?|$)),(USER-AGENT,%E9%97%B2%E9%B1%BC*)),REJECT
DOMAIN,yyapp-httpdns.gslb.yy.com,REJECT
